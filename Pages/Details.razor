@page "/Details/{Id:int}"
@inject NavigationManager Nav

<PageTitle>@(anime?.Title ?? "Carregando...") | Animes</PageTitle>

@if (anime is null)
{
    <div class="min-h-screen bg-[#020509] flex items-center justify-center">
        <div class="flex flex-col items-center gap-4">
            <div class="w-10 h-10 rounded-full border-2 border-[#3B82F6]/30 border-t-[#3B82F6] animate-spin"
                 aria-label="Carregando"></div>
            <span class="font-['Bebas_Neue'] text-sm tracking-[3px] text-white/25">Carregando...</span>
        </div>
    </div>
}
else
{
    <div class="min-h-screen bg-[#020509]">

        <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
            @if (!string.IsNullOrEmpty(anime.ImageUrl))
            {
                <img src="@anime.ImageUrl" alt="" class="w-full h-full object-cover opacity-30 blur-xl scale-105" />
            }
            <div class="absolute inset-0 bg-gradient-to-b from-[#020509]/70 via-[#020509]/85 to-[#020509]"></div>
            <div class="absolute top-[-100px] right-[-100px] w-[600px] h-[600px] rounded-full bg-[#1D4ED8]/5 blur-[120px]">
            </div>
            <div class="absolute bottom-0 left-[-80px] w-[400px] h-[400px] rounded-full bg-[#0EA5E9]/5 blur-[100px]"></div>
        </div>

        <nav
            class="relative z-20 sticky top-0 px-6 md:px-12 py-4 flex items-center justify-between bg-[#040810]/80 backdrop-blur-xl border-b border-white/5">
            <button @onclick="GoBack" aria-label="Voltar para página inicial"
                    class="group inline-flex items-center gap-2.5 text-white/50 hover:text-white transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#3B82F6] focus:ring-offset-2 focus:ring-offset-[#040810] rounded-full">
                <span
                    class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-sm group-hover:bg-[#1D4ED8]/30 group-hover:border-[#3B82F6]/40 transition-all duration-200">
                    ←
                </span>
                <span class="font-['Inter'] text-[13px] tracking-wide hidden sm:block">Voltar</span>
            </button>

            <span class="font-['Bebas_Neue'] text-xl tracking-[5px] text-white/70 select-none">
                ANIME<span class="text-[#3B82F6]">.</span>
            </span>

            <div class="w-1.5 h-1.5 rounded-full bg-[#3B82F6] shadow-[0_0_8px_#3B82F6] animate-pulse" aria-hidden="true">
            </div>
        </nav>

        <main class="relative z-10 px-6 md:px-12 lg:px-20 py-12 md:py-16 max-w-6xl mx-auto">
            <div class="flex flex-col lg:flex-row gap-10 lg:gap-16">
                <div class="flex-shrink-0 flex justify-center lg:justify-start">
                    <div class="relative w-[220px] sm:w-[260px] lg:w-[300px]">
                        <div
                            class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-[80%] h-12 rounded-full bg-[#1D4ED8]/20 blur-2xl">
                        </div>
                        <div
                            class="relative rounded-2xl overflow-hidden border border-[#1D4ED8]/20 shadow-[0_24px_64px_rgba(0,0,0,0.6)]">
                            @if (!string.IsNullOrEmpty(anime.ImageUrl))
                            {
                                <img src="@anime.ImageUrl" alt="@anime.Title" class="w-full aspect-[2/3] object-cover" />
                            }
                            else
                            {
                                <div
                                    class="w-full aspect-[2/3] bg-gradient-to-br from-[#0D1B2A] to-[#060D1A] flex items-center justify-center">
                                    <span class="font-['Bebas_Neue'] text-6xl text-white/10 tracking-[6px]">AN</span>
                                </div>
                            }
                            <div
                                class="absolute top-0 inset-x-0 h-1/3 bg-gradient-to-b from-white/[0.05] to-transparent pointer-events-none">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex-1 flex flex-col gap-6">
                    <div>
                        <h1
                            class="font-['Bebas_Neue'] text-[clamp(36px,6vw,72px)] leading-[0.95] tracking-wide text-white mb-3">
                            @anime.Title
                        </h1>
                        <div class="h-px w-24 bg-gradient-to-r from-[#3B82F6] to-transparent"></div>
                    </div>

                    <div class="rounded-xl p-5 bg-[#0D1B2A]/50 border border-white/10 backdrop-blur-sm">
                        <p class="font-['Inter'] text-[14px] md:text-[15px] leading-8 text-white/70 font-light">
                            @anime.Description
                        </p>
                    </div>

                    <div class="pt-2">
                        <button @onclick="GoBack" aria-label="Voltar para o catálogo"
                                class="group inline-flex items-center gap-3 px-6 py-3 rounded-full bg-[#1D4ED8]/15 border border-[#3B82F6]/25 text-[#93C5FD] font-['Inter'] text-[13px] hover:bg-[#1D4ED8]/35 hover:border-[#60A5FA]/50 transition-all duration-300 active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#3B82F6] focus:ring-offset-2 focus:ring-offset-[#020509]">
                            <span class="text-xs group-hover:-translate-x-1 transition-transform">←</span>
                            Voltar para o catálogo
                        </button>
                    </div>
                </div>
            </div>
        </main>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Anime? anime { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var all = await Data.GetAnimes();
        anime = all.FirstOrDefault(a => a.Id == Id);
    }

    private void GoBack() => Nav.NavigateTo("/");
}