@page "/Details/{Id:int}"
@inject NavigationManager Nav

<PageTitle>@(anime?.Title ?? "Carregando...") | Animes</PageTitle>

@if (anime is null)
{
    <div class="loading" role="status" aria-label="Carregando anime">
        <div class="loading__inner">
            <div class="loading__spinner anim-spin" aria-hidden="true"></div>
            <span class="loading__text">Carregando...</span>
        </div>
    </div>
}
else
{
    <div class="page anim-fade-in">

        
        <div class="page__backdrop" aria-hidden="true">
            @if (!string.IsNullOrEmpty(anime.ImageUrl))
            {
                <img class="page__backdrop-image"
                     src="@anime.ImageUrl" alt="" />
            }
            <div class="page__backdrop-gradient"></div>
            <div class="page__backdrop-orb page__backdrop-orb--tr"></div>
            <div class="page__backdrop-orb page__backdrop-orb--bl"></div>
        </div>

        
        <nav class="nav">
            <button class="nav__back"
                    @onclick="GoBack"
                    aria-label="Voltar para o catálogo">
                <span class="nav__back-circle" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 16 16"
                         fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M10 3L5 8l5 5"/>
                    </svg>
                </span>
                <span class="nav__back-label">Voltar</span>
            </button>

            <span class="nav__logo">ANIME<span>.</span></span>

            <div class="nav__spacer" aria-hidden="true"></div>
        </nav>

        
        <main class="main">
            <article class="article anim-fade-slide-up" aria-label="Detalhes de @anime.Title">

                
                <aside class="cover">
                    <div class="cover__inner">
                        <div class="cover__shadow" aria-hidden="true"></div>

                        <figure class="cover__figure">
                            @if (!string.IsNullOrEmpty(anime.ImageUrl))
                            {
                                <img class="cover__image"
                                     src="@anime.ImageUrl"
                                     alt="Capa de @anime.Title"
                                     loading="eager" />
                            }
                            else
                            {
                                <div class="cover__placeholder"
                                     role="img"
                                     aria-label="Capa não disponível">
                                    AN
                                </div>
                            }
                            <div class="cover__shine" aria-hidden="true"></div>
                        </figure>
                    </div>
                </aside>

                
                <div class="info">

                    <header class="info__header">
                        <h1 class="info__title">@anime.Title</h1>
                        <div class="info__divider" aria-hidden="true"></div>
                    </header>

                    <section aria-label="Descrição">
                        <div class="info__description-card">
                            <p class="info__description-text">@anime.Description</p>
                        </div>
                    </section>

                    <div>
                        <button class="info__back-btn"
                                @onclick="GoBack"
                                aria-label="Voltar para o catálogo">
                            <svg width="16" height="16" viewBox="0 0 16 16"
                                 fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M10 3L5 8l5 5"/>
                            </svg>
                            Voltar para o catálogo
                        </button>
                    </div>
                </div>

            </article>
        </main>
    </div>
}


@code {
    [Parameter]
    public int Id { get; set; }

    private Anime? anime { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var all = await Data.GetAnimes();
        anime   = all.FirstOrDefault(a => a.Id == Id);
    }

    private void GoBack() => Nav.NavigateTo("/");
}

